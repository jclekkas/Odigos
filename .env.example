# Copy to .env and fill in what you use. Blank values turn the matching
# feature off. The app does not ship with API keys.

# --- Required for quote analysis -------------------------------------------
# Any OpenAI-compatible server. Examples:
#   OpenAI:    leave OPENAI_BASE_URL blank, OPENAI_MODEL=gpt-4o
#   Ollama:    OPENAI_BASE_URL=http://127.0.0.1:11434/v1  OPENAI_MODEL=llama3.1
#   LM Studio: OPENAI_BASE_URL=http://127.0.0.1:1234/v1   OPENAI_MODEL=local-model
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=
# Used only when the primary model returns model_not_found.
# On a custom base URL this stays off unless you set it.
OPENAI_FALLBACK_MODEL=

# Legacy names from the hosted deployment. Used only when the OPENAI_* name
# above is blank. Do not set these on a self-hosted install.
# AI_INTEGRATIONS_OPENAI_API_KEY=
# AI_INTEGRATIONS_OPENAI_BASE_URL=
# AI_INTEGRATIONS_OPENAI_MODEL=
# AI_INTEGRATIONS_OPENAI_FALLBACK_MODEL=

# --- App --------------------------------------------------------------------
NODE_ENV=development
PORT=5000
# Optional. Without it, analyses stay in memory for the life of the process.
# DATABASE_URL=postgresql://odigos:odigos@localhost:5432/odigos
# DATABASE_URL_STAGING=
# DATABASE_URL_TEST=
# Optional shared rate-limit store. In-memory limits are used when unset.
# REDIS_URL=
# Optional. Admin routes return 503 until this is set.
# ADMIN_KEY=
# Signs the "email me a copy" token (HMAC-SHA256). The email route reads the
# message from this signature and ignores any body on the request, so the
# server can only mail text it produced.
# If EMAIL_TOKEN_SECRET is unset or blank, SESSION_SECRET is used instead.
# If both are unset or blank, nothing is signed: the email button stays
# hidden and POST /api/email-preview returns 503. There is no built-in key.
# EMAIL_TOKEN_SECRET=
# Also the fallback signing key for email tokens when EMAIL_TOKEN_SECRET is blank.
# SESSION_SECRET=

# --- Optional hosted services (all off when unset) --------------------------
# Error tracking
# SENTRY_DSN=
# SENTRY_ENABLED=
# VITE_SENTRY_DSN=
# VITE_SENTRY_ENABLED=
# Product analytics
# VITE_POSTHOG_KEY=
# VITE_POSTHOG_HOST=
# Stripe is not used for new checkouts. These only matter for old webhooks.
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_PRICE_ID_29=
# STRIPE_PRICE_ID_49=
# STRIPE_PRICE_ID_79=
# VITE_STRIPE_PUBLISHABLE_KEY=
# Vercel Blob, for hosted screenshot upload. Paste-text analysis does not need it.
# BLOB_READ_WRITE_TOKEN=
# Alert email and webhook. Neither is contacted when unset.
# "Email me a copy" also needs EMAIL_TOKEN_SECRET or SESSION_SECRET (see above).
# With neither secret set, that route returns 503 and does not send.
# ALERT_SMTP_URL=
# ALERT_EMAIL_TO=
# ALERT_EMAIL_FROM=
# ALERT_WEBHOOK_URL=
# ALERT_EXTRA_RULES=
# Google Search Console admin page.
# GSC_SITE_URL=
# GOOGLE_SERVICE_ACCOUNT_JSON=
# Off-site Postgres backups.
# BACKUP_REMOTE_ENABLED=
# BACKUP_S3_BUCKET=
# BACKUP_S3_REGION=
# BACKUP_S3_PREFIX=
# BACKUP_LOCAL_RETENTION_DAYS=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# TARGET_DB_URL=
# RESTORE_VERIFY_DB_URL=
# RESTORE_VERIFY_MAX_AGE_HOURS=

# --- Tuning (defaults are fine) ---------------------------------------------
# AI_CB_FAILURE_THRESHOLD=5
# AI_CB_WINDOW_MS=60000
# AI_CB_COOLDOWN_MS=30000
# WAREHOUSE_WRITE_CONCURRENCY=5
# WAREHOUSE_QUEUE_MAX_DEPTH=1000
# DLQ_PAGE_SIZE=20
# DLQ_LEASE_TIMEOUT_MS=120000
# DLQ_REPLAY_INTERVAL_MINUTES=15
# CANONICAL_DOMAIN_ACTIVE=
# CHROMIUM_PATH=
# BASE_URL=
